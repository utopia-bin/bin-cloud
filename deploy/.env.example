# 复制为 deploy/.env 后填写真实配置。不要提交 deploy/.env。
TZ=Asia/Shanghai

# Nacos 位于 Docker 宿主机时使用 host.docker.internal；位于其他服务器时填写其内网地址。
NACOS_SERVER_ADDR=host.docker.internal:8848
NACOS_NAMESPACE=bin-cloud
NACOS_DISCOVERY_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE_ME

# MySQL 与 Redis
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=bin_platform
MYSQL_USERNAME=bin_cloud
MYSQL_PASSWORD=CHANGE_ME
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DATABASE=0

# 所有网关、API 和平台服务必须使用相同的签名密钥。
JWT_SECRET=CHANGE_ME
GATEWAY_CONTEXT_SIGNING_SECRET=CHANGE_ME
JWT_EXPIRATION=7200

# Dubbo
DUBBO_PROTOCOL_PORT=20880

# 各服务 JVM 内存，可按服务器资源调整。
GATEWAY_JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai
ADMIN_API_JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai
OPEN_API_JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai
PLATFORM_JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m -Duser.timezone=Asia/Shanghai
