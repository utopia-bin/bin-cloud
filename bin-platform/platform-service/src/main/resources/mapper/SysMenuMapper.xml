<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.utopiabin.cloud.platform.mapper.iam.SysMenuMapper">

    <!-- 菜单是导航视图，角色授权只绑定权限资源。 -->
    <select id="selectMenusByPermissionCodes" resultType="cn.utopiabin.cloud.platform.entity.iam.SysMenu">
        SELECT m.*
        FROM `sys_menu` m
        WHERE m.`is_delete` = 0
          AND m.`available` = 1
          AND (
            #{allPermissions} = TRUE
            OR m.`permission` IS NULL
            OR m.`permission` = ''
            <if test="permissionCodes != null and !permissionCodes.isEmpty()">
                OR m.`permission` IN
                <foreach collection="permissionCodes" item="code" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>
          )
        ORDER BY m.`sort` ASC, m.`id` DESC
    </select>

</mapper>
