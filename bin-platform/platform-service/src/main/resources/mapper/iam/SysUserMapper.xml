<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.utopiabin.cloud.platform.mapper.iam.SysUserMapper">
    <select id="selectInitializationUserIdsForUpdate" resultType="long">
        SELECT id FROM sys_user
        WHERE tenant_id = #{tenantId} AND username = #{username}
        <if test="!includeDeleted">AND is_delete = 0</if>
        FOR UPDATE
    </select>
</mapper>
