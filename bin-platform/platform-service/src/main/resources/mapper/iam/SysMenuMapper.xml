<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.utopiabin.cloud.platform.mapper.iam.SysMenuMapper">
    <select id="selectConsoleMenuIdsIncludingDeletedForUpdate" resultType="long">
        SELECT id FROM sys_menu
        WHERE application_id = 1 AND path = #{path}
        FOR UPDATE
    </select>
</mapper>
